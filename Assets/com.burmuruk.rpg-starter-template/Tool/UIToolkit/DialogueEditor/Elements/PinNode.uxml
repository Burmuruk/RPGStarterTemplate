<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/com.burmuruk.rpg-starter-template/Tool/UIToolkit/Styles/Node.uss?fileID=7433441132597879392&amp;guid=1c7a9ec9ca23a9448940524cf01bc1e8&amp;type=3#Node" />
    <Style src="project://database/Assets/com.burmuruk.rpg-starter-template/Tool/UIToolkit/Styles/BasicSS.uss?fileID=7433441132597879392&amp;guid=2693b02dba201b24e87668e3aaaa0fc1&amp;type=3#BasicSS" />
    <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="PinNodeContainer" style="min-height: 100px; padding-top: 3px; padding-right: 3px; padding-bottom: 3px; padding-left: 3px; max-width: 200px;">
        <ui:VisualElement name="state" class="dialogue-node" style="flex-grow: 0; flex-shrink: 1; flex-direction: row; align-items: center; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; width: 100%;">
            <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="btnStart" class="statusButton" />
            <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="btnDialogue" class="statusButton" />
            <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="btnMission" class="statusButton" />
            <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="btnPin" class="statusButton" />
        </ui:VisualElement>
        <ui:VisualElement class="LineContainer">
            <ui:TextField picking-mode="Ignore" multiline="true" tooltip="Note" name="txtNote" />
        </ui:VisualElement>
    </ui:Button>
</ui:UXML>
